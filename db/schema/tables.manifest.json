        "caste_id", "sub_caste_id", "gothram_id", "willing_other_caste",
        "about_me", "profile_photo_privacy", "profile_source", "is_sample",
        "completeness_pct", "created_at", "updated_at", "deleted_at", "row_version"
      ],
      "pk": ["profile_id"],
      "unique": ["user_id", "matrimony_id"],
      "fks": [
        {"column": "user_id", "ref_table": "users", "ref_column": "user_id"}
      ],
      "indexes": ["matrimony_id", "gender", "religion_id", "caste_id", "age", "is_sample"]
    },
    "profile_horoscopes": {
