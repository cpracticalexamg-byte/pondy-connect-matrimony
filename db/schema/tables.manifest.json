{
  "schema_version": "2.0.0",
  "engine": "Azure SQL Database / SQL Server compatible",
  "tables": {
    "schema_meta": {
      "columns": ["key", "value", "created_at", "updated_at"],
      "pk": ["key"],
      "description": "Metadata tracking schema version and migration history."
    },
    "users": {
      "columns": [
        "user_id", "mobile", "email", "password_hash", "salt", "status",
        "is_verified", "is_sample", "created_at", "updated_at", "deleted_at", "row_version"
      ],
      "pk": ["user_id"],
      "unique": ["mobile"],
      "indexes": ["mobile", "email", "status"],
      "description": "Authentication and account credentials. Passwords store PBKDF2/argon2 hashes."
    },
    "user_sessions": {
      "columns": [
        "session_id", "user_id", "token_hash", "device_info", "ip_address",
        "created_at", "expires_at", "revoked_at"
      ],
      "pk": ["session_id"],
      "fks": [{"column": "user_id", "ref_table": "users", "ref_column": "user_id"}],
      "indexes": ["user_id", "token_hash"]
    },
    "otp_requests": {
      "columns": [
        "request_id", "mobile", "otp_hash", "attempts", "is_verified",
        "lockout_until", "expires_at", "created_at"
      ],
      "pk": ["request_id"],
      "indexes": ["mobile", "expires_at"]
    },
    "profiles": {
      "columns": [
        "profile_id", "user_id", "matrimony_id", "name", "gender", "dob", "age",
        "height_cm", "weight_kg", "body_type_id", "complexion_id", "blood_group_id",
